# Only these PUBLIC_ values are included in the browser build.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets. Configure in Supabase Edge Functions, never in frontend code.
TURNSTILE_SECRET_KEY=
OPENAI_API_KEY=
REVIEW_RATE_SALT=
REVIEW_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Built-in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase itself.
