# Only these PUBLIC_ values are included in the browser build.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
# Activate only after content.sql, content-api and initial catalog import are deployed.
PUBLIC_CONTENT_ENABLED=false

# Server-only secrets. Configure in Supabase Edge Functions, never in frontend code.
TURNSTILE_SECRET_KEY=
OPENAI_API_KEY=
REVIEW_RATE_SALT=
REVIEW_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Built-in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase itself.

# Server-only personalized email configuration. Test recipient ONLY until authorized.
RESEND_API_KEY=
PERSONALIZED_MAIL_FROM=
PERSONALIZED_MAIL_TO=
# Mario's destination must be enabled separately after testing is approved.
